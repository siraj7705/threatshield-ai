# ThreatShield AI — Docker Compose environment
# Copy this file to .env (same folder as docker-compose.yml) and adjust.
# `docker compose` reads .env automatically for variable substitution
# in docker-compose.yml; the backend service also loads these as its
# runtime environment variables.

# ─── Postgres ──────────────────────────────────────────────────────
POSTGRES_USER=threatshield
POSTGRES_PASSWORD=threatshield_dev_password_change_me
POSTGRES_DB=threatshield
POSTGRES_PORT=5432

# Used by the backend container; must match the values above.
DATABASE_URL=postgresql+asyncpg://threatshield:threatshield_dev_password_change_me@postgres:5432/threatshield

# ─── Application ───────────────────────────────────────────────────
APP_NAME=ThreatShield AI
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-secure-random-string-in-production
API_HOST=0.0.0.0
API_PORT=8000

# ─── JWT ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ─── NLP / ML ──────────────────────────────────────────────────────
NLP_MODEL_PATH=./ml_models
SPACY_MODEL=en_core_web_sm

# ─── Email Processing ─────────────────────────────────────────────
MAX_EMAIL_SIZE_MB=25
ALLOWED_EXTENSIONS=.eml,.msg,.txt

# ─── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/threatshield.log

# ─── Gmail Integration (optional) ─────────────────────────────────
# Leave blank to disable Gmail live monitoring entirely.
# 1. Create OAuth credentials in Google Cloud Console, download as
#    backend/credentials.json (NEVER commit this file).
# 2. Run the one-time auth flow locally to generate
#    backend/gmail_token.json (also never commit).
# 3. Set a Pub/Sub topic for push notifications.
# 4. APP_BASE_URL must be a publicly reachable HTTPS URL (e.g. ngrok)
#    so Google can deliver webhook callbacks to it.
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=gmail_token.json
GMAIL_PUBSUB_TOPIC=
GMAIL_ADMIN_EMAIL=
GMAIL_WATCHER_EMAIL=
APP_BASE_URL=http://localhost:8000

# ─── URL Analysis (optional) ───────────────────────────────────────
# Get a free key at https://developers.google.com/safe-browsing
GOOGLE_SAFE_BROWSING_API_KEY=

# ─── IP Reputation / VPN-Tor-Proxy Detection (optional, free tier) ─
# ip-api.com is free for non-commercial use, no key required, but is
# rate-limited (45 req/min). Leave IP_REPUTATION_PROVIDER as ip-api
# unless you have a paid provider key.
IP_REPUTATION_PROVIDER=ip-api
IP_REPUTATION_API_KEY=

# ─── ClamAV (attachment scanning) ─────────────────────────────────
# These point at the clamav service in docker-compose.yml. No changes
# needed unless you're running ClamAV outside Compose.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# ─── Elasticsearch (search) ────────────────────────────────────────
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_ENABLED=true

# ─── Frontend build-time API URL ──────────────────────────────────
# Leave empty for Docker (nginx proxies /api -> backend). Set to a
# full URL only if you're pointing the built frontend at a remote API.
VITE_API_URL=
